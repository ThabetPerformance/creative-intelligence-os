# Creative Intelligence OS — environment variables (names only, never commit values)

# Postgres connection string (Neon pooled URL recommended on Vercel). Required.
DATABASE_URL=

# Random 32+ character secret. Signs the access-gate session cookie. Required in production.
APP_ENCRYPTION_KEY=

# Optional shared password that protects the whole app. Strongly recommended on any public URL.
APP_ACCESS_PASSWORD=

# Windsor.ai API key. SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_. Optional (File Mode needs none).
WINDSOR_API_KEY=

# Public base URL of the deployment, e.g. https://creative-intelligence-os.vercel.app
APP_BASE_URL=

# Secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>" for scheduled Windsor refresh.
CRON_SECRET=

# FILE | WINDSOR | HYBRID — default data mode for newly created accounts.
DEFAULT_DATA_MODE=FILE
